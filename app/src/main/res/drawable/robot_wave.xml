<?xml version="1.0" encoding="utf-8"?>
<!--
  Frame animation of the NYP robot mascot waving its left arm.
  Frames are generated by rotating the arm around the elbow (-8°..+18°) and loop
  smoothly: f0..f5 then back to f0. Must be started in code via AnimationDrawable.start().
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/robot_wave_f0" android:duration="90" />
    <item android:drawable="@drawable/robot_wave_f1" android:duration="90" />
    <item android:drawable="@drawable/robot_wave_f2" android:duration="90" />
    <item android:drawable="@drawable/robot_wave_f3" android:duration="120" />
    <item android:drawable="@drawable/robot_wave_f4" android:duration="90" />
    <item android:drawable="@drawable/robot_wave_f5" android:duration="90" />
</animation-list>
