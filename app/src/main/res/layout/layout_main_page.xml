<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FOND NOIR ET CONTENU PRINCIPAL -->
    <RelativeLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- 1. BARRE DU HAUT (Logo + Paramètres) -->

        <!-- 2. BARRE DE RECHERCHE TEXTE (Ancrée tout en bas) -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- NOUVEAU LOGO SANS FOND BLANC -->
            <ImageView
                android:id="@+id/nypLogo"
                android:layout_width="250dp"
                android:layout_height="160dp"
                android:layout_alignParentStart="true"
                android:background="@null"
                android:contentDescription="@string/nyp_logo"
                android:src="@drawable/nyp_logo" />

            <!-- BOUTONS HAUT DROITE (Passés en blanc pour être visibles) -->
            <ImageButton
                android:id="@+id/timeButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_toStartOf="@id/settingsButton"
                android:background="@android:color/transparent"
                android:src="@drawable/drawable_hourglass"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:background="@android:color/transparent"
                android:src="@drawable/drawable_settings"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- 3. LE CENTRE (Robot + Bouton Vocal de taille normale) -->

        <LinearLayout
            android:id="@+id/bottomSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="91dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="500dp"
                android:layout_height="80dp"
                android:layout_marginTop="-0dp"
                android:layout_marginEnd="20dp"
                android:background="#FFFFFF"
                android:hint="Type your question here..."
                android:padding="15dp"
                android:textSize="25sp" />

            <Button
                android:id="@+id/sendTextButton"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:text="Send"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <!-- LE ROBOT QUI S'ANIME -->

            <!-- LE BOUTON BLEU -->
            <ImageView
                android:id="@+id/menuRobotCharacter"
                android:layout_width="350dp"
                android:layout_height="350dp"
                android:src="@drawable/robot_smile" />

            <Button
                android:id="@+id/interactionButton"
                android:layout_width="620dp"
                android:layout_height="170dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/button_blue_transparent"
                android:text="Click on the button to ask me something\nor type your question below"
                android:textColor="@android:color/white"
                android:textSize="26sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ========================================== -->
    <!-- LES OVERLAYS (Cachés par défaut)           -->
    <!-- ========================================== -->

    <FrameLayout
        android:id="@+id/helloOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Hello !"
            android:textColor="#FFFFFF"
            android:textSize="220sp"
            android:textStyle="bold" />
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/readingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:padding="50dp">

        <!-- VISAGE PENDANT LA LECTURE -->
        <ImageView
            android:id="@+id/robotFace"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:src="@drawable/smiling_temi"
            android:tag="smiling" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/closeReadingButton"
            android:layout_below="@id/robotFace"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/readingTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:text="The answer will show here..." />
        </ScrollView>

        <Button
            android:id="@+id/closeReadingButton"
            android:layout_width="400dp"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#0055A6"
            android:text="Finish / Ask Another Question"
            android:textColor="@android:color/white"
            android:textSize="25sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/sleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/sleepRobotImage"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_centerInParent="true"
            android:src="@drawable/sleeping_temi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sleepRobotImage"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="I'm taking a quick nap! 💤\nWave your hand or touch the screen to wake me up!"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:textStyle="bold" />
    </RelativeLayout>
</FrameLayout>