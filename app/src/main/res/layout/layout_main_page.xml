<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/nypLogo"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:src="@drawable/nyp_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/callButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#FFFFFF" />

            <Button
                android:id="@+id/langButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginEnd="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="🇬🇧 EN"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/mapMenuButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/timeButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomContainer"
        android:layout_below="@id/topBar"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text="Hi there, it's Temi! How can I help you?"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/menuRobotCharacter"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="15dp"
            android:src="@drawable/robot_smile" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/cardPool"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:text="Where is the swimming pool?"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/cardLibrary"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:text="Where is the library?"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/cardClubs"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:text="Tell me about Student Clubs"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/cardBursary"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:text="How do I apply for a bursary?"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/cardPhoto"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/button_blue_transparent"
                android:text="📸 Take a selfie with me!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnShowMap"
                android:layout_width="360dp"
                android:layout_height="100dp"
                android:layout_margin="10dp"
                android:background="@drawable/button_blue_transparent"
                android:text="🗺️ Show Interactive Map"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textAllCaps="false" />


        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="30dp"
        android:paddingBottom="25dp">

        <Button
            android:id="@+id/interactionButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginEnd="15dp"
            android:layout_weight="1"
            android:background="@drawable/button_blue_transparent"
            android:text="Press here or Wave at me"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Type your question here..."
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="22sp" />

            <Button
                android:id="@+id/sendTextButton"
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:background="@drawable/button_blue_transparent"
                android:text="SEND"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/readingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/robotFace"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:src="@drawable/smiling_temi"
            android:tag="smiling" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/closeReadingButton"
            android:layout_below="@+id/robotFace"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="50dp"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/readingTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:lineSpacingExtra="8dp"
                android:textSize="38sp" />
        </ScrollView>

        <Button
            android:id="@+id/closeReadingButton"
            android:layout_width="280dp"
            android:layout_height="90dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="50dp"
            android:background="@drawable/button_blue_transparent"
            android:text="FINISH"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/sleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/sleepRobotImage"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_centerInParent="true"
            android:src="@drawable/sleeping_temi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sleepRobotImage"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="I'm taking a quick nap! 💤\nWave your hand or touch the screen to wake me up!"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/arrivedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/arrivedRobotFace"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"
            android:src="@drawable/smiling_temi" />

        <TextView
            android:id="@+id/arrivedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/arrivedRobotFace"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="We have arrived!"
            android:textColor="#FFFFFF"
            android:textSize="50sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/arrivedText"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAskQuestion"
                android:layout_width="350dp"
                android:layout_height="120dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/button_blue_transparent"
                android:text="Ask another question"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCallContact"
                android:layout_width="350dp"
                android:layout_height="120dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/button_blue_transparent"
                android:text="Call someone"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGoHome"
                android:layout_width="350dp"
                android:layout_height="120dp"
                android:background="@drawable/button_blue_transparent"
                android:text="Return to Home Base"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:padding="30dp">

        <TextView
            android:id="@+id/mapTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="📍 Navigation Menu"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/closeMapButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/button_blue_transparent"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/mapTitle"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Boutons de cartes générés dynamiquement (MainPage) selon les
                 cartes présentes sur le robot : NYP RIG et NYP BOA ont chacun
                 les leurs. Le ScrollView évite le débordement si un robot a
                 beaucoup de cartes. -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fadeScrollbars="false">

                <LinearLayout
                    android:id="@+id/mapsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Select Area"
                        android:textColor="#00BFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp"/>
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#55FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Choose Destination"
                    android:textColor="#00BFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadeScrollbars="false">

                    <GridLayout
                        android:id="@+id/destinationsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- MENU OVERLAY POUR LES LANGUES -->
    <RelativeLayout
        android:id="@+id/langOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="15dp">

        <TextView
            android:id="@+id/langTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"
            android:text="🌍 Select your language"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="true">

            <Button android:id="@+id/btnLangEn" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇬🇧 English" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btnLangZh" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇨🇳 中文\n(Mandarin)" android:textColor="#FFFFFF" android:textSize="22sp" />
            <Button android:id="@+id/btnLangMs" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇲🇾 Bahasa\nMelayu" android:textColor="#FFFFFF" android:textSize="22sp" />
            <Button android:id="@+id/btnLangFr" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇫🇷 Français" android:textColor="#FFFFFF" android:textSize="24sp" />
            <Button android:id="@+id/btnLangJa" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇯🇵 日本語\n(Japanese)" android:textColor="#FFFFFF" android:textSize="22sp" />
            <Button android:id="@+id/btnLangDe" android:layout_width="200dp" android:layout_height="100dp" android:layout_margin="15dp" android:background="@drawable/card_bg" android:text="🇩🇪 Deutsch" android:textColor="#FFFFFF" android:textSize="24sp" />
        </GridLayout>

        <Button
            android:id="@+id/closeLangButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="30dp"
            android:background="@drawable/button_blue_transparent"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
    </RelativeLayout>
</RelativeLayout>