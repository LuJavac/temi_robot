<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/nypLogoLoading"
        android:layout_width="350dp"
        android:layout_height="120dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="20dp"
        android:src="@drawable/nyp_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Let me think..."
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="italic" />

    <ImageView
        android:id="@+id/robotRunning"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_below="@id/nypLogoLoading"
        android:layout_marginStart="100dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/running_temi"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/robotLoading"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="80dp"
        android:src="@drawable/loading_temi"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/robotIdea"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="100dp"
        android:src="@drawable/idea_temi"
        android:visibility="invisible" />

</RelativeLayout>