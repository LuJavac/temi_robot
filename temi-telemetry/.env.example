# Copier ce fichier vers .env puis changer TOUTES les valeurs secretes.
# Le fichier .env ne doit jamais etre commit (il est dans le .gitignore).

# Jeton partage entre le robot et l'API d'ingestion (header Authorization: Bearer ...)
# Doit correspondre a TELEMETRY_TOKEN dans l'app Android (TelemetryClient.kt).
API_TOKEN=change-me-temi-telemetry-token

# InfluxDB (initialise automatiquement au premier demarrage)
INFLUXDB_USERNAME=temi
INFLUXDB_PASSWORD=change-me-influx-password
INFLUXDB_ORG=nyp
INFLUXDB_BUCKET=temi
INFLUXDB_TOKEN=change-me-influx-admin-token

# Grafana (http://192.168.1.43:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
